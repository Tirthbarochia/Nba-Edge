{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/insights",
      "schedule": "0 16 * * *"
    }
  ],
  "functions": {
    "api/insights.js": {
      "maxDuration": 60
    },
    "api/lines.js": {
      "maxDuration": 60
    }
  }
}

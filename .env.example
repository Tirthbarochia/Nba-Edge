# Private SERVER-SIDE environment variables. Set these in Vercel Project Settings.
# Rotate any key that has been shared in chat before deploying publicly.
ODDS_API_KEY=REPLACE_WITH_NEW_ROTATED_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Private token the server functions send to Supabase to read and write the saved sportsbook
# snapshot. Generate a long random value; store only its SHA-256 hash in the database
# (see supabase/odds_store.sql). Never put it in config.js or any browser file.
NBA_EDGE_SERVER_TOKEN=REPLACE_WITH_LONG_RANDOM_VALUE
# Optional sportsbook budget settings (defaults shown).
# ODDS_REFRESHES_PER_DAY=1
# ODDS_REFRESH_MINUTES=60
# ODDS_FIRST_REFRESH_HOUR_ET=11
# ODDS_SCANNER_DAILY_CREDITS=10
# Optional: enables the signed-in "Explain with AI" button.
# OPENAI_API_KEY=
